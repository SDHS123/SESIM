rules_version = '2';

// 세심제(SESIM) Firestore 보안 규칙
// 적용 방법: Firebase 콘솔 → Firestore Database → 규칙 탭에 전체 붙여넣고 [게시]
//
// 권한 체계 (roles/{소문자 이메일} 문서)
//  - 일반 학생   : 문서 없음
//  - 부스 관리자 : { role: 'booth', boothId: 숫자 }  → 자기 부스만 관리
//  - 총괄 어드민 : { role: 'super' }                 → 전체 관리 (첫 총괄은 콘솔에서 직접 추가)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 학교 계정인지 확인
    // 학교 도메인이 정해지면 아래 줄 주석을 풀고 도메인을 바꾸세요. (firebase-config.js 의 SCHOOL_EMAIL_DOMAIN 도 같이)
    function isSchool() {
      return signedIn();
        // && request.auth.token.email.matches('.*@학교도메인[.]kr$');
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(myEmail());
    }

    function myRole() {
      return get(rolePath()).data;
    }

    function isSuper() {
      return signedIn() && exists(rolePath()) && myRole().role == 'super';
    }

    function managesBooth(boothId) {
      return signedIn() && exists(rolePath())
        && myRole().role == 'booth' && myRole().boothId == boothId;
    }

    function canManage(boothId) {
      return isSuper() || managesBooth(boothId);
    }

    function boothPath(boothId) {
      return /databases/$(database)/documents/booths/$(string(boothId));
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------- 권한 목록 ----------
    // 본인 권한은 본인이 확인 가능, 전체 목록은 총괄만.
    // 총괄도 "자기 자신"의 권한은 수정/삭제 불가 → 실수로 총괄이 0명이 되는 사고 방지
    match /roles/{email} {
      allow read: if signedIn() && (email == myEmail() || isSuper());

      allow create, update: if isSuper()
        && email != myEmail()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['role', 'boothId', 'updatedAt', 'updatedBy'])
        && (
          (request.resource.data.role == 'super' && !('boothId' in request.resource.data))
          || (request.resource.data.role == 'booth'
              && request.resource.data.boothId is int
              && exists(boothPath(request.resource.data.boothId)))
        );

      allow delete: if isSuper() && email != myEmail();
    }

    // ---------- 부스 정보 ----------
    // 누구나 열람. 총괄은 전체 수정, 부스 관리자는 자기 부스의 "운영 상태"만 변경
    match /booths/{boothId} {
      allow read: if true;

      allow create: if isSuper()
        && request.resource.data.status in ['OPEN', 'BREAK', 'CLOSED'];

      allow update: if request.resource.data.status in ['OPEN', 'BREAK', 'CLOSED']
        && (
          isSuper()
          || (managesBooth(int(boothId)) && onlyChanged(['status', 'updatedAt', 'updatedBy']))
        );

      allow delete: if isSuper();
    }

    // ---------- 학생 프로필 (학번, 이름, 전화번호) ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow write: if isSchool() && request.auth.uid == uid;
    }

    // ---------- 부스 예약 ----------
    // 개인정보 없음 (uid, boothId, 인원, 상태, 시간) → 순번 계산을 위해 로그인한 학생 누구나 열람
    match /reservations/{id} {
      allow read: if isSchool();

      // 운영 중(OPEN)인 부스에만 예약 가능 + 연락처(contacts) 문서와 반드시 함께 생성
      allow create: if isSchool()
        && request.resource.data.keys().hasOnly(['uid', 'boothId', 'party', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.boothId is int
        && request.resource.data.party is int
        && request.resource.data.party >= 1 && request.resource.data.party <= 4
        && request.resource.data.status == 'WAIT'
        && request.resource.data.createdAt == request.time
        && get(boothPath(request.resource.data.boothId)).data.status == 'OPEN'
        && existsAfter(/databases/$(database)/documents/contacts/$(id));

      allow update: if onlyChanged(['status']) && (
          // 학생 본인: 대기/호출 상태인 예약을 "취소"만 가능
          (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['WAIT', 'CALLED']
            && request.resource.data.status == 'CANCELED')
          // 담당 부스 관리자 / 총괄: 호출, 완료, 노쇼 등 처리
          || (canManage(resource.data.boothId)
            && request.resource.data.status in ['WAIT', 'CALLED', 'DONE', 'NOSHOW', 'CANCELED'])
        );

      allow delete: if isSuper();
    }

    // ---------- 예약자 연락처 (예약 1건당 1개, 문서 ID = 예약 ID) ----------
    // 본인 + 해당 부스 관리자 + 총괄만 열람 → 다른 부스 관리자는 볼 수 없음
    match /contacts/{resId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || canManage(resource.data.boothId));

      allow create: if isSchool()
        && request.resource.data.keys().hasOnly(['uid', 'boothId', 'email', 'studentId', 'name', 'phone', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.studentId is string && request.resource.data.studentId.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 50
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/reservations/$(resId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservations/$(resId)).data.boothId == request.resource.data.boothId;

      allow update: if false;
      allow delete: if isSuper();
    }

    // ---------- 사이트 전체 설정 (메인 화면 모드 등) ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuper()
        && request.resource.data.heroMode in ['dday', 'festival'];
    }
  }
}
